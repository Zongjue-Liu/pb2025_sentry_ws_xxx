<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="rmul2026_ul_occupy_first">
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <ReactiveSequence>
          <ReactiveFallback name="GameStartGuard">
            <IsGameStatus name="IsGameStart"
                          expected_game_progress="4"
                          min_remain_time="0"
                          max_remain_time="300"
                          key_port="{@referee_gameStatus}"/>
            <AlwaysFailure/>
          </ReactiveFallback>

          <ReactiveFallback name="EmergencyStopGuard">
            <Inverter>
              <IsEmergencyStop emergency_stop="{@referee_emergencyStop}"/>
            </Inverter>
            <AlwaysFailure/>
          </ReactiveFallback>

          <ForceSuccess name="InitializeMotionEpoch">
            <Fallback>
              <RunOncePerEpoch epoch="{@motion_epoch}">
                <Sequence>
                  <PublishSpinSpeed spin_speed="6.0"
                                    duration="0.0"
                                    topic_name="cmd_spin"/>
                  <PubNav2Goal goal="4.8;-3.5;0.0"
                               topic_name="goal_pose"/>
                </Sequence>
              </RunOncePerEpoch>
              <AlwaysFailure/>
            </Fallback>
          </ForceSuccess>

          <ReactiveFallback name="OccupyStatusGuard">
            <IsStatusOK hp_min="220"
                        heat_max="234"
                        ammo_min="0"
                        key_port="{@referee_robotStatus}"/>
            <ForceFailure>
              <Sequence name="ReturnHomeIfUnsafe">
                <PubNav2Goal goal="0.0;0.0;0.0"
                             topic_name="goal_pose"/>
              </Sequence>
            </ForceFailure>
          </ReactiveFallback>

          <ReactiveFallback name="OccupyFirstULStrategy">
            <Sequence name="ControlZoneWindowEarly">
              <IsGameStatus expected_game_progress="4"
                            min_remain_time="230"
                            max_remain_time="250"
                            key_port="{@referee_gameStatus}"/>
              <PubNav2Goal goal="4.8;-3.5;0.0"
                           topic_name="goal_pose"/>
            </Sequence>

            <Sequence name="ControlZoneWindowLate">
              <IsGameStatus expected_game_progress="4"
                            min_remain_time="120"
                            max_remain_time="140"
                            key_port="{@referee_gameStatus}"/>
              <PubNav2Goal goal="4.8;-3.5;0.0"
                           topic_name="goal_pose"/>
            </Sequence>

            <Sequence name="AttackNearEnemy">
              <IsDetectEnemy max_distance="2.5"
                             lost_timeout="0.0"
                             message_timeout="0.5"
                             detector_sequence="{@detector_sequence}"
                             motion_epoch="{@motion_epoch}"
                             key_port="{@detector_armors}"/>
              <ReactiveFallback>
                <Sequence>
                  <CalculateAttackPose costmap_port="{@nav_globalCostmap}"
                                       tracker_port="{@tracker_target}"
                                       goal="{attack_pose}"
                                       topic_name="debug_attack_pose"/>
                  <PubNav2Goal goal="{attack_pose}"
                               topic_name="goal_pose"/>
                </Sequence>
                <PubNav2Goal goal="4.8;-3.5;0.0"
                             topic_name="goal_pose"/>
              </ReactiveFallback>
            </Sequence>

            <Sequence name="PatrolDefault">
              <PubNav2Goal goal="4.8;-3.5;0.0"
                           topic_name="goal_pose"/>
            </Sequence>
          </ReactiveFallback>
        </ReactiveSequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
